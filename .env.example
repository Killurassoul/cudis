# ------------------------------------------------------------
# CUDIS — Variables d'environnement
# Copier ce fichier vers .env.local (jamais commité) et renseigner
# les valeurs réelles. Ne jamais commiter de clé privée.
# ------------------------------------------------------------

# --- Supabase (Projet > Settings > API) ---
# URL et clé "anon" : publics, utilisés par le site et /gestion.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Clé "service_role" : SECRETE, uniquement côté serveur
# (routes /api/contact et /api/assistant). Jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Administration (/gestion) ---
# Couche de confort côté navigateur : e-mails admis à se connecter.
# La sécurité réelle reste assurée par les policies RLS (app.admin_emails).
# Plusieurs e-mails séparés par des virgules.
VITE_ADMIN_EMAILS=Rassoulgye@gmail.com

# --- Notifications e-mail (Resend) ---
# https://resend.com — clé API requise pour l'envoi réel.
# Sans clé, les messages restent enregistrés mais aucun e-mail n'est envoyé.
RESEND_API_KEY=
# Expéditeur : doit être un domaine vérifié chez Resend.
CONTACT_EMAIL_FROM=CUDIS <notifications@cudis.com>
# Destinataire(s) des notifications, séparés par des virgules.
CONTACT_EMAIL_TO=contact@cudis.com

# --- Assistant IA (optionnel, désactivé par défaut) ---
# true seulement quand le budget IA est validé ; false = aucune requête LLM.
ENABLE_AI_ASSISTANT=false
# Fournisseur : gemini (défaut) | anthropic | openai
AI_PROVIDER=gemini
# Modèle (facultatif) : sinon valeur par défaut du fournisseur.
# Exemples : gemini-2.0-flash, claude-3-5-haiku-20241022, gpt-4o-mini
# AI_MODEL=
# Clé du fournisseur choisi (une seule est nécessaire).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
